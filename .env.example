# --- AI (Groq, free tier) ---
GROQ_API_KEY=
GROQ_API_KEY_2=                     # optional backup key, used if the first is rate limited
GROQ_MODEL=openai/gpt-oss-120b

# --- PayPal sandbox (leave empty to run in SIMULATED mode) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                  # from the sandbox app's webhook settings

# --- Sellers (sandbox personal accounts that receive payouts), comma separated ---
SELLER_EMAILS=

# --- Database ---
# Empty = embedded Postgres (PGlite) stored in ./.data (great for local dev).
# For Vercel, paste a Supabase Postgres connection string here.
DATABASE_URL=

# --- App ---
SESSION_SECRET=change-me-to-a-long-random-string
PLATFORM_FEE_RATE=0.10
UNDO_WINDOW_MINUTES=10
NEXT_PUBLIC_APP_URL=http://localhost:3000
